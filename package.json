{
  "name": "jev-gate",
  "version": "0.1.0",
  "description": "A GitHub Action that reviews pull requests with TypeSafe Jev: calibrated rules for danger and breaking changes, with advisory quality scores.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "jev-gate": "dist/bundle/cli.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin/tsconfig.json",
    "test": "npm run build && tsc -p plugin/tsconfig.json && node --test dist/*.test.js plugin/dist/*.test.js",
    "test:one": "node --test",
    "cli": "node dist/bundle/cli.cjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "@opencode/plugin": "2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totally-tim/jev-gate.git"
  },
  "homepage": "https://github.com/totally-tim/jev-gate#readme",
  "bugs": {
    "url": "https://github.com/totally-tim/jev-gate/issues"
  }
}
